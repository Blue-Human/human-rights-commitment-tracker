   "notes": [],
   "statements": [
    {
     "section": "Dec",
     "section_title": "Declarations and Reservations",
     "notes": [],
     "label": "Declaration",
     "kind": "declaration",
     "text": "\"According to article 12 of the Optional Protocol from 19 December 2011 to the Convention on the Rights of the Child on a communications procedure, the Principality of Liechtenstein declares that it recognises the competence of the Committee on the Rights of the Child to receive and consider communications in which a State party claims that the Principality of Liechtenstein does not fulfil its obligations under any of the following instruments: the Convention on the Rights of the Child, the Optional Protocol to the Convention on the Rights of the Child on the involvement of children in armed conflict, or the Optional Protocol to the Convention on the Rights of the Child on the sale of children, child prostitution and child pornography.\""
    }
   ],
